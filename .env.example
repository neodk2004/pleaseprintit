# Kopieren nach .env und Werte ändern. Die .env nie in Git hochladen.
# Zufallswerte erzeugen: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_PASSWORD=langes-zufaelliges-passwort
SECRET_KEY=lange-zufaellige-zeichenkette

# Öffentliche Adresse, wenn die App hinter einem Reverse Proxy mit HTTPS läuft
# (für Einladungslinks und sichere Cookies). Leer lassen für reinen Heimnetz-Betrieb.
# PUBLIC_URL=https://druck.example.de

# Zeitzone (Standard: Europe/Berlin)
# TZ=Europe/Berlin

# Optional: Status-Mails (SMTP-Zugang deines Mail-Anbieters). Leer lassen = keine Mails.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURITY=starttls        # starttls (Port 587) | ssl (Port 465) | none
# SMTP_USER=druck@example.org
# SMTP_PASSWORD=app-passwort
# SMTP_FROM=PleasePrintit <druck@example.org>
