# Kopieren nach .env und Werte ändern. Die .env nie in Git hochladen.
ADMIN_PASSWORD=langes-zufaelliges-passwort
SECRET_KEY=lange-zufaellige-zeichenkette

# Nur auf dem NAS:
# Öffentliche Adresse (für Einladungslinks und sichere Cookies)
PUBLIC_URL=https://ppp.neodk.ipv64.de
# Server-Ergänzung automatisch mitladen (Proxy-Netz + tägliche Sicherung)
COMPOSE_FILE=compose.yaml:compose.server.yaml

# Optional: Status-Mails an Freunde (SMTP-Zugang deines Mail-Anbieters). Leer lassen = keine Mails.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURITY=starttls        # starttls (Port 587) | ssl (Port 465) | none
# SMTP_USER=druck@example.org
# SMTP_PASSWORD=app-passwort
# SMTP_FROM=PleasePrintit <druck@example.org>

# Optional: Zugang für Push-Nachrichten über ntfy. Einfacher: Einstellungen → Benachrichtigungen, dort auch die Adresse des Themas.
# NTFY_TOKEN=tk_...

# Optional: Thingiverse-Vorschau (App-Token von thingiverse.com/developers)
# THINGIVERSE_TOKEN=

# Optional: Cults3D-Vorschau (Nickname und API-Key aus dem Cults-Konto)
# CULTS3D_USER=
# CULTS3D_KEY=
